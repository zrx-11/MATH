  "glossary": [
    {
      "term": "复利终值",
      "def": "S=P(1+i)ⁿ，本金按复利计息 n 期后的本息合计",
      "chapterId": "ch01"
    },
    {
      "term": "年金现值",
      "def": "每期支付 R 共 n 期，按利率 i 折现到今天的总额",
      "chapterId": "ch01"
    },
    {
      "term": "判别式",
      "def": "二次方程 Δ=b²−4ac，决定实根个数；二次曲线 Δ=B²−4AC 决定类型",
      "chapterId": "ch01"
    },
    {
      "term": "双曲函数",
      "def": "由 eˣ 与 e⁻ˣ 组合定义的函数，满足 cosh²−sinh²=1",
      "chapterId": "ch02"
    },
    {
      "term": "半对数坐标",
      "def": "一个轴取对数、一个轴取线性，用来把指数律画成直线",
      "chapterId": "ch02"
    },
    {
      "term": "双对数坐标",
      "def": "两个轴都取对数，用来把幂律画成直线",
      "chapterId": "ch02"
    },
    {
      "term": "海伦公式",
      "def": "由三边直接算三角形面积：S=√(p(p−a)(p−b)(p−c))，p 为半周长",
      "chapterId": "ch03"
    },
    {
      "term": "球面三角",
      "def": "球面上以球心角表示的边与角构成的三角形，满足球面余弦定理",
      "chapterId": "ch03"
    },
    {
      "term": "点积",
      "def": "a·b=|a||b|cosθ，结果是一个数，用来算夹角与投影",
      "chapterId": "ch03"
    },
    {
      "term": "叉积",
      "def": "a×b，方向垂直两者，模等于张成平行四边形面积",
      "chapterId": "ch03"
    },
    {
      "term": "高斯曲率",
      "def": "两个主曲率之积 K=κ₁κ₂，是曲面的内蕴量",
      "chapterId": "ch03"
    },
    {
      "term": "行列式",
      "def": "方阵对应的一个数，其绝对值是变换对面积或体积的缩放倍数",
      "chapterId": "ch04"
    },
    {
      "term": "秩",
      "def": "矩阵所含线性无关行或列的个数，决定方程组解的结构",
      "chapterId": "ch04"
    },
    {
      "term": "特征值",
      "def": "使 Av=λv 有非零解 v 的数 λ",
      "chapterId": "ch04"
    },
    {
      "term": "四元数",
      "def": "形如 a+bi+cj+dk 的数，乘法不交换，用于表示三维旋转",
      "chapterId": "ch04"
    },
    {
      "term": "偏导数",
      "def": "把其余变量视为常数时对某一变量的导数",
      "chapterId": "ch05"
    },
    {
      "term": "梯度",
      "def": "各偏导组成的向量，指向函数增长最快的方向",
      "chapterId": "ch05"
    },
    {
      "term": "方向导数",
      "def": "函数沿某单位方向的瞬时变化率，等于梯度在该方向的投影",
      "chapterId": "ch05"
    },
    {
      "term": "隐函数定理",
      "def": "若 F_y≠0，则方程 F(x,y)=0 在局部可解出 y=y(x)",
      "chapterId": "ch05"
    },
    {
      "term": "比值判据",
      "def": "若 lim a(n+1)/a(n)<1 则正项级数收敛，>1 则发散",
      "chapterId": "ch06"
    },
    {
      "term": "傅里叶级数",
      "def": "把周期函数展开成不同频率正弦余弦之和",
      "chapterId": "ch06"
    },
    {
      "term": "雅可比行列式",
      "def": "坐标变换偏导组成的行列式，其绝对值是面积或体积元的缩放倍数",
      "chapterId": "ch06"
    },
    {
      "term": "积分因子",
      "def": "乘以它可把一阶线性方程左边化为一个乘积的导数",
      "chapterId": "ch07"
    },
    {
      "term": "特征根",
      "def": "二阶常系数线性方程对应的二次方程的根，三种情形决定解的形式",
      "chapterId": "ch07"
    },
    {
      "term": "分离变量法",
      "def": "设 u=X(x)T(t) 把偏微分方程拆成若干常微分方程的方法",
      "chapterId": "ch07"
    },
    {
      "term": "条件概率",
      "def": "在已知 B 发生的条件下 A 发生的概率，P(A|B)=P(A∩B)/P(B)",
      "chapterId": "ch08"
    },
    {
      "term": "全概率公式",
      "def": "P(A)=ΣP(A|Bᵢ)P(Bᵢ)，Bᵢ 构成完备事件组",
      "chapterId": "ch08"
    },
    {
      "term": "中心极限定理",
      "def": "大量独立同分布随机变量之和近似正态分布",
      "chapterId": "ch08"
    },
    {
      "term": "置信区间",
      "def": "由样本构造的区间，反复抽样时约有一定比例的区间包含真值",
      "chapterId": "ch08"
    },
    {
      "term": "无偏估计",
      "def": "期望等于被估计参数的估计量",
      "chapterId": "ch08"
    },
    {
      "term": "第一类错误",
      "def": "原假设为真却被拒绝，概率为显著性水平 α",
      "chapterId": "ch08"
    }
  ],
