      "chapterId": "ch02",
      "front": "悬链线的方程形式？",
      "back": "y=a cosh(x/a)",
      "tags": [
        "函数"
      ]
    },
    {
      "id": "ch02-f05",
      "chapterId": "ch02",
      "front": "算图法的原理是什么？",
      "back": "用三条刻度尺的连线读出结果，本质是射影对应",
      "tags": [
        "函数"
      ]
    },
    {
      "id": "ch03-f01",
      "chapterId": "ch03",
      "front": "正弦定理怎么写？",
      "back": "a/sin A = b/sin B = c/sin C = 2R",
      "tags": [
        "几何"
      ]
    },
    {
      "id": "ch03-f02",
      "chapterId": "ch03",
      "front": "海伦公式？",
      "back": "S=√(p(p−a)(p−b)(p−c))，p 为半周长",
      "tags": [
        "几何"
      ]
    },
    {
      "id": "ch03-f03",
      "chapterId": "ch03",
      "front": "混合积为零说明什么？",
      "back": "三个向量共面，平行六面体体积为零",
      "tags": [
        "几何"
      ]
    },
    {
      "id": "ch03-f04",
      "chapterId": "ch03",
      "front": "高斯曲率为什么决定能否摊平？",
      "back": "它是内蕴量，等距变形不能改变它，非零则无法等距映射到平面",
      "tags": [
        "几何"
      ]
    },
    {
      "id": "ch03-f05",
      "chapterId": "ch03",
      "front": "二次曲线怎么分类？",
      "back": "看判别式 B²−4AC：小于零椭圆，等于零抛物线，大于零双曲线",
      "tags": [
        "几何"
      ]
    },
    {
      "id": "ch04-f01",
      "chapterId": "ch04",
      "front": "矩阵乘法什么时候能做？",
      "back": "左矩阵列数等于右矩阵行数，结果取外维",
      "tags": [
        "矩阵"
      ]
    },
    {
      "id": "ch04-f02",
      "chapterId": "ch04",
      "front": "行列式为零意味着什么？",
      "back": "矩阵不可逆，变换把空间压到低维，信息丢失",
      "tags": [
        "矩阵"
      ]
    },
    {
      "id": "ch04-f03",
      "chapterId": "ch04",
      "front": "方程组三种解情形怎么判断？",
      "back": "比较 rank(A) 与 rank([A|b]) 及未知数个数",
      "tags": [
        "矩阵"
      ]
    },
    {
      "id": "ch04-f04",
      "chapterId": "ch04",
      "front": "实对称矩阵的特征向量有什么性质？",
      "back": "特征值全实，特征向量互相正交，可正交对角化",
      "tags": [
        "矩阵"
      ]
    },
    {
      "id": "ch04-f05",
      "chapterId": "ch04",
      "front": "四元数适合表示什么？",
      "back": "三维旋转，优点是无万向锁、可平滑插值",
      "tags": [
        "矩阵"
      ]
    },
    {
      "id": "ch05-f01",
      "chapterId": "ch05",
      "front": "梯度的两个性质？",
      "back": "方向是最快增长方向，模是最大变化率",
      "tags": [
        "微分"
      ]
    },
    {
      "id": "ch05-f02",
      "chapterId": "ch05",
      "front": "方向导数怎么写？",
      "back": "∂f/∂l=∇f·l，l 为单位向量",
      "tags": [
        "微分"
      ]
    },
    {
      "id": "ch05-f03",
      "chapterId": "ch05",
      "front": "多元极值的二阶判别式？",
      "back": "Δ=AC−B²，A=f_xx，C=f_yy，B=f_xy；Δ>0 且 A>0 为极小，Δ<0 为鞍点",
      "tags": [
        "微分"
      ]
    },
    {
      "id": "ch05-f04",
      "chapterId": "ch05",
      "front": "隐函数求导公式？",
      "back": "dy/dx=−F_x/F_y，条件是 F_y≠0",
      "tags": [
        "微分"
      ]
    },
    {
      "id": "ch05-f05",
      "chapterId": "ch05",
      "front": "泰勒展开的余项有什么用？",
      "back": "给出误差上界，决定取几阶才能达到要求精度",
      "tags": [
        "微分"
      ]
    },
    {
      "id": "ch06-f01",
      "chapterId": "ch06",
      "front": "比值判据怎么用？",
      "back": "lim a(n+1)/a(n)<1 收敛，>1 发散，=1 失效",
      "tags": [
        "积分"
      ]
    },
    {
      "id": "ch06-f02",
      "chapterId": "ch06",
      "front": "调和级数收敛吗？",
      "back": "发散，它说明通项趋于零不保证收敛",
      "tags": [
        "积分"
      ]
    },
    {
      "id": "ch06-f03",
      "chapterId": "ch06",
      "front": "分部积分公式？",
      "back": "∫u dv=uv−∫v du",
      "tags": [
        "积分"
      ]
    },
    {
      "id": "ch06-f04",
      "chapterId": "ch06",
      "front": "球坐标的体积元？",
      "back": "ρ²sinφ dρ dφ dθ",
      "tags": [
        "积分"
      ]
    },
    {
      "id": "ch06-f05",
      "chapterId": "ch06",
      "front": "傅里叶系数怎么算？",
      "back": "aₙ=(1/π)∫f cos nx dx，bₙ=(1/π)∫f sin nx dx",
      "tags": [
        "积分"
      ]
    },
    {
      "id": "ch07-f01",
      "chapterId": "ch07",
      "front": "一阶线性方程的积分因子？",
      "back": "e^(∫Pdx)，乘上后左边变成 (y e^(∫Pdx))'",
      "tags": [
        "方程"
      ]
    },
    {
      "id": "ch07-f02",
      "chapterId": "ch07",
      "front": "二阶常系数方程三种特征根对应什么？",
      "back": "相异实根、重根、共轭复根，对应过阻尼、临界、欠阻尼",
      "tags": [
        "方程"
      ]
    },
    {
      "id": "ch07-f03",
      "chapterId": "ch07",
      "front": "PDE 三类怎么分？",
      "back": "按 B²−4AC：小于零椭圆，等于零抛物，大于零双曲",
      "tags": [
        "方程"
      ]
    },
    {
      "id": "ch07-f04",
      "chapterId": "ch07",
      "front": "分离变量法的核心动作？",
      "back": "设 u=X(x)T(t)，把 PDE 拆成两个 ODE",
      "tags": [
        "方程"
      ]
    },
    {
      "id": "ch07-f05",
      "chapterId": "ch07",
      "front": "为什么椭圆型方程不需要初始条件？",
      "back": "它描述稳态，没有时间方向，只需边界条件",
      "tags": [
        "方程"
      ]
    },
    {
      "id": "ch08-f01",
      "chapterId": "ch08",
      "front": "贝叶斯公式？",
      "back": "P(B|A)=P(A|B)P(B)/P(A)",
      "tags": [
        "概率"
      ]
    },
    {
      "id": "ch08-f02",
      "chapterId": "ch08",
      "front": "样本方差为什么除以 n−1？",
      "back": "除以 n 会系统性低估总体方差，n−1 才是无偏估计",
      "tags": [
        "概率"
      ]
    },
    {
      "id": "ch08-f03",
      "chapterId": "ch08",
      "front": "95% 置信区间的正确解释？",
      "back": "反复抽样构造的区间中约 95% 包含真值，不是单个区间有 95% 概率包含真值",
      "tags": [
        "概率"
      ]
    },
    {
      "id": "ch08-f04",
      "chapterId": "ch08",
      "front": "中心极限定理说什么？",
      "back": "大量独立同分布随机变量之和近似正态，是统计推断的基础",
      "tags": [
        "概率"
      ]
    },
    {
      "id": "ch08-f05",
      "chapterId": "ch08",
      "front": "两类错误各是什么？",
      "back": "第一类：H₀ 真却拒绝，概率 α；第二类：H₀ 假却不拒绝，概率 β",
      "tags": [
        "概率"
      ]
    }
  ]
}